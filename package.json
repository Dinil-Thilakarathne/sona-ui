{
  "name": "sonaui",
  "version": "0.1.0",
  "private": true,
  "description": "Sona UI",
  "author": "sonacode",
  "license": "MIT",
  "homepage": "https://sona-ui.vercel.app",
  "type": "module",
  "scripts": {
    "predev": "bun run sync:releases",
    "dev": "next dev --turbopack",
    "prebuild": "bun run build:registry && bun run build:agent-resources && bun run sync:releases",
    "build:registry": "bun run scripts/build-registry.ts && bun run scripts/build-registry-json.ts && node --experimental-strip-types scripts/build-prop-types.ts",
    "build:agent-resources": "bun scripts/build-agent-resources.ts",
    "build:registry:local": "REGISTRY_BASE_URL=http://127.0.0.1:3000/r bun run build:registry",
    "check:registry": "bun run scripts/validate-registry.ts",
    "check:agent-resources": "bun scripts/validate-agent-resources.ts",
    "check:agent-resource-drift": "bun run build:agent-resources && git diff --exit-code -- public/agent public/llms.txt public/llms-full.txt",
    "check:agent-skill": "bun scripts/validate-agent-skill.ts",
    "check:agent-contracts": "bun scripts/check-agent-contracts.ts",
    "check:agent-readiness": "bun scripts/check-agent-readiness.ts",
    "check:registry-consumers": "bun run scripts/check-registry-consumers.ts",
    "check:registry-production": "bun run scripts/check-production-registry-install.ts",
    "check:a11y": "bun run scripts/check-accessibility.mjs",
    "sync:releases": "bun run scripts/sync-releases.ts",
    "content:build": "bun scripts/build-content-collections.ts",
    "typecheck": "bun run content:build && tsc --noEmit",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "@guideframe/core": "^0.2.0-beta.6",
    "@guideframe/react": "^0.2.0-beta.6",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.10",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.77",
    "@radix-ui/react-dialog": "^1.1.23",
    "@types/mdx": "^2.0.14",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "arktype": "^2.2.3",
    "caniuse-lite": "^1.0.30001809",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cuelume": "^0.1.2",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^12.43.0",
    "next": "^16.3.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "next-view-transitions": "^0.3.5",
    "posthog-js": "^1.418.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-use-measure": "^2.1.7",
    "shadow-plugin": "^2.1.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "torph": "^0.1.0",
    "usehooks-ts": "^3.1.1",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.3",
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "baseline-browser-mapping": "^2.11.18",
    "biome-tailwind-sorter": "^0.2.11",
    "playwright": "^1.62.1",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "patchedDependencies": {
    "biome-tailwind-sorter@0.2.11": "patches/biome-tailwind-sorter@0.2.11.patch"
  }
}
